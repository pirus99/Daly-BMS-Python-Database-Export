# .env.example – copy this file to .env and adjust the values for your setup.
# All variables are optional; the defaults listed here are used if a variable
# is absent.

# ---------------------------------------------------------------------------
# Serial interface
# ---------------------------------------------------------------------------

# Path to the USB-to-RS485 (or UART) serial device.
# Linux example  : /dev/ttyUSB0
# macOS example  : /dev/tty.usbserial-A10PHKWC
# Windows example: COM3
SERIAL_PORT=/dev/ttyUSB0

# Set to "true" to use UART mode instead of RS-485.
# RS-485 is the default for most USB-to-RS485 adapters.
BMS_UART=false

# Set to "true" to enable verbose (DEBUG) mode in the dalybms library.
# This is a workaround for BMS firmware versions where the --status command
# does not respond at normal timing.
# Turn On to use BMS_DEBUG_LOG, or if --status flag is not working with your BMS firmware version.
BMS_VERBOSE=false

# Set to "true" to show DEBUG-level output in the console / log files.
BMS_DEBUG_LOG=false

# Set to "true" when your BMS uses a Sinowealth chip.
# This selects the dalybms.DalyBMSSinowealth driver instead of DalyBMS.
BMS_SINOWEALTH=false


# ---------------------------------------------------------------------------
# Daly BMS device settings
# ---------------------------------------------------------------------------

# Model name shown as a Prometheus label.
BMS_MODEL=Daly BMS

# Instance identifier – useful when monitoring several packs.
BMS_INSTANCE=bms0


# ---------------------------------------------------------------------------
# Data-fetch toggles
#
# Some BMS firmware versions do not respond correctly to every command.
# Set any of these to "false" to skip that command entirely.
#
# If you disable FETCH_STATUS but still want per-cell voltages/temperatures,
# set BMS_CELL_COUNT and BMS_TEMP_SENSOR_COUNT to your pack's actual values.
# ---------------------------------------------------------------------------

FETCH_SOC=true
FETCH_CELL_VOLTAGE_RANGE=true
FETCH_TEMPERATURE_RANGE=true
FETCH_MOSFET_STATUS=true
FETCH_STATUS=true
FETCH_CELL_VOLTAGES=true
FETCH_TEMPERATURES=true
FETCH_BALANCING=true
FETCH_ERRORS=true

# Fallback counts used when FETCH_STATUS=false.
# 0 means "skip cell voltages / temperatures as well".
BMS_CELL_COUNT=0
BMS_TEMP_SENSOR_COUNT=0


# ---------------------------------------------------------------------------
# Prometheus HTTP server
# ---------------------------------------------------------------------------

# Address to bind.  Use 0.0.0.0 for all interfaces.
WEB_SERVER_ADDRESS=0.0.0.0

# TCP port for the metrics endpoint.
WEB_SERVER_PORT=8000

# URL path for the Prometheus scrape endpoint.
METRICS_PATH=/metrics


# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# How often (seconds) the BMS is queried for fresh data.
POLL_INTERVAL=10.0

# Maximum seconds a single poll may take before it is interrupted.
POLL_TIMEOUT=10.0

# Number of consecutive errors before daly_bms_up is set to 0.
MAX_CONSECUTIVE_ERRORS=3
