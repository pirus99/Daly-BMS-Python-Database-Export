# .env.example – copy this file to .env and adjust the values for your setup.
# All variables are optional; the defaults listed here are used if a variable
# is absent.

# ---------------------------------------------------------------------------
# Serial / RS-485 interface
# ---------------------------------------------------------------------------

# Path to the USB-to-RS485 device.
# Linux example  : /dev/ttyUSB0
# macOS example  : /dev/tty.usbserial-A10PHKWC
# Windows example: COM3
SERIAL_PORT=/dev/ttyUSB0

# Baud rate (Daly BMS default is 9600).
BAUD_RATE=9600

# Serial read timeout in seconds.
SERIAL_TIMEOUT=1.0


# ---------------------------------------------------------------------------
# Daly BMS device settings
# ---------------------------------------------------------------------------

# RS-485 address of the BMS.  Factory default is 0x40 (decimal 64).
# Can be specified as hex (0x40) or decimal (64).
BMS_ADDRESS=0x40

# Human-readable model name shown as a Prometheus label.
BMS_MODEL=Daly BMS

# Instance identifier – useful when monitoring several packs.
BMS_INSTANCE=bms0


# ---------------------------------------------------------------------------
# Prometheus HTTP server
# ---------------------------------------------------------------------------

# Address to bind.  Use 0.0.0.0 for all interfaces.
WEB_SERVER_ADDRESS=0.0.0.0

# TCP port for the metrics endpoint.
WEB_SERVER_PORT=8000

# URL path for the Prometheus scrape endpoint.
METRICS_PATH=/metrics


# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# How often (seconds) the BMS is queried for fresh data.
POLL_INTERVAL=10.0

# Number of consecutive errors before daly_bms_up is set to 0.
MAX_CONSECUTIVE_ERRORS=3
